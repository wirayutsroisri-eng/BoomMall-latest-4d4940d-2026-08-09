{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.boommall.app",
        "EXPO_PUBLIC_PRIVACY_URL": "https://api.boommall.app/legal/privacy",
        "EXPO_PUBLIC_TERMS_URL": "https://api.boommall.app/legal/terms"
      }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.boommall.app",
        "EXPO_PUBLIC_PRIVACY_URL": "https://api.boommall.app/legal/privacy",
        "EXPO_PUBLIC_TERMS_URL": "https://api.boommall.app/legal/terms"
      }
    },
    "play-internal": {
      "distribution": "store",
      "channel": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.boommall.app",
        "EXPO_PUBLIC_PRIVACY_URL": "https://api.boommall.app/legal/privacy",
        "EXPO_PUBLIC_TERMS_URL": "https://api.boommall.app/legal/terms"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.boommall.app",
        "EXPO_PUBLIC_PRIVACY_URL": "https://api.boommall.app/legal/privacy",
        "EXPO_PUBLIC_TERMS_URL": "https://api.boommall.app/legal/terms"
      }
    }
  },
  "submit": {
    "play-internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "preview": {
      "ios": {
        "appleTeamId": "APZ4563SL9"
      }
    },
    "production": {
      "ios": {
        "appleTeamId": "APZ4563SL9"
      }
    }
  }
}
