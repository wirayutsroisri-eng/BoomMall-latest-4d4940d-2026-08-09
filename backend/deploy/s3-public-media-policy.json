{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadPublishedMedia",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::boommall-media-prod/media/*",
        "arn:aws:s3:::boommall-media-prod/chat-media/*"
      ]
    }
  ]
}
