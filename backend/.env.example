# =============================================================================
# BoomMall Boom Coin API — On-Premise / Private Server
# Copy to `.env` and fill secrets. Never commit `.env`.
# =============================================================================

# --- API ---
PORT=4000
# Bind when using docker compose profile `api` (LAN example: 10.10.0.5)
API_HOST_BIND=0.0.0.0
ADMIN_API_KEY=change-me-admin-key
SUPER_ADMIN_API_KEY=change-me-super-admin-key
# Master key — Super Admin ทั้งระบบ (ใช้ก่อน แยกแผนกทีหลังได้)
MASTER_KEY=change-me-master-key
# บัญชี / Finance admin — Header x-master-key (ไม่ใส่ = ใช้ MASTER_KEY)
# ACCOUNTING_MASTER_KEY=change-me-master-key
# Desk keys — รหัสเข้าถึงแผนกใน Admin OS (ไม่ใส่ = แผนกนั้นปิด)
ADMIN_KEY_SAFETY=change-me-safety-key
ADMIN_KEY_ADS=change-me-ads-key
ADMIN_KEY_FEED=change-me-feed-key
ADMIN_KEY_MARKETPLACE=change-me-marketplace-key
ADMIN_KEY_FINANCE=change-me-finance-key
# Optional extra codes JSON: [{"key":"night-shift","role":"SAFETY","label":"Safety กะดึก"}]
# ADMIN_ACCESS_CODES=
CHAT_SERVICE_API_KEY=change-me-chat-service-key
# Comma-separated Admin UI origins (private IP or hostname)
CORS_ORIGIN=http://10.10.0.5:5173,http://localhost:5173,http://localhost:5173/admin,http://localhost:5175
INITIAL_TREASURY_MINT=100000
NODE_ENV=production
# Seed อัตรา GP ครั้งแรกเท่านั้น (500 = 5%). หลัง migrate แก้ที่ Admin > Sellers > Marketplace GP
# MARKETPLACE_GP_BPS=500

# --- PostgreSQL container (docker compose) ---
POSTGRES_USER=boom
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=boommall_coin
POSTGRES_LOOPBACK_PORT=5432

# --- PgAdmin (profile: host-tools) — loopback only by default ---
PGADMIN_DEFAULT_EMAIL=admin@boommall.local
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password
PGADMIN_HOST_BIND=127.0.0.1
PGADMIN_PORT=5050

# =============================================================================
# Database connection (Backend ↔ PostgreSQL)
# =============================================================================
# Option A (recommended on-prem): discrete fields — URL is built at runtime
#   - Inside Docker network: DATABASE_HOST=postgres
#   - API on host / private IP via loopback proxy: DATABASE_HOST=127.0.0.1
#   - API on another LAN host (only if you intentionally publish DB — not default):
#       DATABASE_HOST=10.10.0.5
# =============================================================================
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=boom
DATABASE_PASSWORD=change-me-strong-db-password
DATABASE_NAME=boommall_coin
DATABASE_SCHEMA=public

# Prisma / pg connection pool (company server defaults)
# connection_limit ≈ (CPU cores * 2) + spare; keep below Postgres max_connections
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=20
DATABASE_CONNECT_TIMEOUT=10
PRISMA_CONNECTION_LIMIT=10

# TLS between API and PostgreSQL (required in production on-prem)
# generate: ./scripts/generate-db-certs.sh
# SAN tip: CERT_SAN_HOSTS=postgres,127.0.0.1,10.10.0.5 ./scripts/generate-db-certs.sh
DATABASE_SSL_MODE=require
DATABASE_SSL_ROOT_CERT=./deploy/certs/ca.crt
# Optional mutual TLS:
# DATABASE_SSL_CERT=./deploy/certs/client.crt
# DATABASE_SSL_KEY=./deploy/certs/client.key

# Option B: full URL (overrides discrete host fields if set)
# Include sslmode + pool params for Prisma CLI (migrate/studio) as well.
# DATABASE_URL="postgresql://boom:change-me-strong-db-password@127.0.0.1:5432/boommall_coin?schema=public&connection_limit=10&pool_timeout=20&connect_timeout=10&sslmode=require&sslrootcert=%2Fopt%2Fboommall%2Fbackend%2Fdeploy%2Fcerts%2Fca.crt"

# --- Backups (scripts/backup.sh) ---
BACKUP_DIR=./var/backups/postgres
BACKUP_RETENTION_DAYS=14

# --- Auth / JWT ---
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=7d
# App Store Review demo account (seeded on boot; recreated if reviewers delete it)
APPLE_REVIEW_EMAIL=apple-review@boommall.com
APPLE_REVIEW_PASSWORD=Password1234
# Sign in with Apple — Services ID / bundle ID that is the token `aud`
APPLE_CLIENT_ID=com.boommall.superapp
# Google — accept any of these as id_token audience (`aud`)
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
# Facebook Login — App ID (public) + App Secret for appsecret_proof
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# LAN only. Never set in production — skips JWKS and allows x-user-id impersonation.
# ALLOW_DEV_AUTH=1

# --- Phone SMS OTP ---
# twilio | http | unset (dev: log OTP to API console; production refuses unless ALLOW_DEV_AUTH)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+66xxxxxxxx
# Thai / custom gateway:
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://sms-gateway.example/send
# SMS_HTTP_TOKEN=
# SMS_HTTP_FROM=BoomMall

# --- Payments (never fake success in production) ---
# omise | stripe | truemoney | mock_dev | unset=refuse
PSP_PROVIDER=
OMISE_SECRET_KEY=
STRIPE_SECRET_KEY=
# Seller auto-payout (defaults to PSP_PROVIDER). unset = Manual queue only.
# PAYOUT_PROVIDER=omise|mock_dev
# OMISE_DEFAULT_RECIPIENT_ID=
# ALLOW_MOCK_PSP=1

# --- Courier tracking webhook (empty = simulator accepts unsigned events) ---
# HMAC-SHA256 of "{trackingNumber}|{event}|{occurredAt}" in header X-Courier-Signature
# COURIER_WEBHOOK_SECRET=change-me-courier-webhook-secret

# --- Chat realtime ---
REDIS_URL=
CHAT_SOCKET_PATH=/socket.io/chat
# Public base used in media URLs returned to the app (LAN IP in on-prem)
# PUBLIC_API_URL=http://10.10.0.5:4000
# CHAT_MEDIA_DIR=./data/chat-media
# Object storage (optional). When set, clients PUT files via presigned URL.
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=boommall-media-storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://10.10.0.5:9000
# CDN_BASE_URL=https://cdn.boommall.local

