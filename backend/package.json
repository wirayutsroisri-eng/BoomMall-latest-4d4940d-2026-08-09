{
  "name": "boommall-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BoomMall marketplace and social API — Express + Prisma + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "node dist/cli/migrate-deploy.js && node dist/index.js",
    "prisma:generate": "tsx scripts/run-prisma.ts generate",
    "prisma:migrate": "tsx scripts/run-prisma.ts migrate dev",
    "prisma:deploy": "tsx scripts/run-prisma.ts migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "feed:rollup": "tsx src/cli/feed-rollup.ts",
    "db:reset": "tsx scripts/run-prisma.ts migrate reset --force",
    "db:certs": "bash scripts/generate-db-certs.sh",
    "db:backup": "bash scripts/backup.sh",
    "db:up": "docker compose up -d --build",
    "db:up:tools": "docker compose --profile host-tools up -d --build",
    "db:up:all": "docker compose --profile host-tools --profile api up -d --build",
    "db:down": "docker compose down",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@prisma/client": "^6.14.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bwip-js": "^4.11.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "morgan": "^1.10.1",
    "pdfkit": "^0.17.2",
    "prisma": "^6.14.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.17.1",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
