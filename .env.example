# Public API the iOS app calls.
#
# Physical iPhone on the same Wi-Fi (fixes "fetch failed"):
#   EXPO_PUBLIC_API_URL=http://YOUR_MAC_LAN_IP:4000
#   Example: http://192.168.1.23:4000
#   Do NOT use http://localhost:4000 on a real device — localhost is the phone itself.
#   Find the Mac IP: System Settings → Wi-Fi → Details, or `ipconfig getifaddr en0`
#
# Simulator can use localhost. TestFlight / App Review need public HTTPS.
EXPO_PUBLIC_API_URL=http://192.168.1.89:4000

# Optional override if Expo cannot see the Metro host (rare). Hostname only, no http://
# EXPO_PUBLIC_DEV_API_HOST=192.168.1.23
# EXPO_PUBLIC_API_PORT=4000
# Set to 1 if the API runs on a different machine than Metro (do not rewrite LAN IP)
# EXPO_PUBLIC_PIN_API_HOST=1

# Hosted legal pages (optional). If unset, the app opens ${EXPO_PUBLIC_API_URL}/legal/privacy|terms
# Only HTTPS public hosts are used in store builds — never localhost.
# EXPO_PUBLIC_PRIVACY_URL=https://api.example.com/legal/privacy
# EXPO_PUBLIC_TERMS_URL=https://api.example.com/legal/terms

# --- Google Sign-In (Google Cloud Console → APIs & Services → Credentials) ---
# Web client ID (also used as backend GOOGLE_CLIENT_ID / GOOGLE_WEB_CLIENT_ID)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# iOS OAuth client — bundle ID must be com.boommall.superapp
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android OAuth client — package com.boommall.superapp (Play builds)
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- Facebook Login (developers.facebook.com) ---
# Add platform iOS bundle com.boommall.superapp
# Valid OAuth Redirect URI: boommall://oauth
EXPO_PUBLIC_FACEBOOK_APP_ID=

# LINE is not enabled until server token verification ships.
# EXPO_PUBLIC_LINE_CHANNEL_ID=
