# Public API the iOS app calls. TestFlight / App Review need HTTPS on the public internet.
# LAN HTTP (http://192.168.x.x:4000) works only on the same Wi-Fi after NSAllowsLocalNetworking.
EXPO_PUBLIC_API_URL=https://api.example.com

# Hosted legal pages (optional). If unset, the app opens ${EXPO_PUBLIC_API_URL}/legal/privacy|terms
# Only HTTPS public hosts are used — never localhost.
# EXPO_PUBLIC_PRIVACY_URL=https://api.example.com/legal/privacy
# EXPO_PUBLIC_TERMS_URL=https://api.example.com/legal/terms

# Optional social login (omit to hide the button in store builds)
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# EXPO_PUBLIC_FACEBOOK_APP_ID=
# LINE is not enabled until server token verification ships.
